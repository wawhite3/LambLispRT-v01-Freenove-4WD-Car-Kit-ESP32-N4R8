# OTA llloader sdkconfig deltas (OTA proposal Build/PlatformIO wiring).
# Rollback: a VM that never mark_valid's rolls back to factory -> the loader.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Task WDT armed at boot; fed inside the OTA-write and network-retry loops.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Trusted root is small: optimize for size, keep it Arduino-core-free.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# NO TLS: the image is authenticated by its own SHA/signature, not the channel
# (private isolated net + per-node token).  mbedTLS stays at IDF defaults, unused.

# BLE console rung (rung 3b): NimBLE host, peripheral-only (advertise + GATT writes).  Central /
# observer roles are off to keep the trusted root small.  Sequential radios: BLE is used for the
# console fallback only, released before WiFi ever runs (never coexisting).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
