{
  "build": {
    "arduino":{
      "ldscript": "esp32_out.ld",
      "partitions": "default_4MB.csv"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32_DEV",
      "-DARDUINO_USB_MODE=1",
      "-DARDUINO_RUNNING_CORE=1",
      "-DARDUINO_EVENT_RUNNING_CORE=1"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32",
    "variant": "auto"
  },
  "connectivity": [
    "bluetooth",
    "wifi"
  ],
  "debug": {
      "openocd_target": "esp32.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "Freenove 4WD Car Kit ESP32-WROVER (4MB flash, 8MB PSRAM)",
  "upload": {
      "flash_size": "4MB",
      "maximum_ram_size": 8716288,
      "maximum_size": 4194304,
      "require_upload_port": true,
      "speed": 460800,
      "chip" : "auto"
  },
  "url": "https://github.com/Freenove/Freenove_4WD_Car_Kit_for_ESP32",
  "vendor": "Freenove"
}
